#
# Patch for https://github.com/stereolabs/zed-ros2-wrapper at commit
# f134486a814111b1c737a41211113dee41921776.
#
# Adds no class member, no method, and no C++ exception:
#
# Multi-camera in-process safety (both ZedCamera and ZedCameraOne):
#   - initNode(): when startCamera() fails, log "Camera start failed. Component
#     stopped.", run deInitNode(), and return instead of exit(EXIT_FAILURE).
#   - initNode(): move initServices() below startCamera() so a failed component
#     advertises no service against an uninitialized camera handle.
#   - Grab thread: on a critical grab error, set the stop flag and leave the
#     grab loop instead of exit(EXIT_FAILURE).
#   - Pre-shutdown callback: capture weak_from_this() so destroyed components
#     do not dangle on the global ROS context.
#
# ZedCameraOne dynamic video parameter fixes:
#   - handleExposure(): map "video.denoising" (already registered and applied
#     by applyExposureCompensationAndDenoising(), only omitted from dispatch).
#   - applyWhiteBalance(), applyExposure(), applyAnalogGain(): when switching
#     auto_* from true to false, mark the paired manual scalar dirty so a
#     manual target equal to the stored parameter is still written to the SDK.
#   - applyExposure(), applyAnalogGain(): skip resetting the auto range to
#     [28, 30000] / [1000, 16000] when explicit range bounds are already dirty
#     in the same update (including startup overrides on frame 0).
#
# Apply with `git apply` in a checkout at the commit above. Lines before the
# first "diff --git" are ignored by `git apply`.
#
# Classification of every exit(EXIT_FAILURE) call at that commit. Line numbers
# are those of the unpatched files in zed_components/src/.
#
# | File, lines | Function and thread | Condition | Patched |
# |---|---|---|---|
# | zed_camera/src/zed_camera_component_main.cpp 122, 127 | constructor | null ROS context | no, cannot occur in a running process |
# | same, 153 | constructor | SDK version check | no, compile-time constant, SDK 5.5.0 passes |
# | same, 216 | initNode, 50 ms one-shot timer | startCamera() returned false | yes |
# | same, 1084, 1108, 1133, 1159 | getGeneralParams | `else if (!IS_JETSON)` branches | no, non-Jetson host |
# | same, 1214 | getGeneralParams | virtual stereo without two serials | no |
# | same, 3569, 3583, 3597 | startCamera | setting read, inside `if (_debugCamCtrl && !mSvoMode)` and `if (!sl_tools::isZEDX(...))` | no, USB models |
# | same, 3612 to 3710 (8) and 3727 to 3831 (8) | startCamera | setting read, inside `if (_debugCamCtrl && !mSvoMode)` (line 3555) | no, debug flag only |
# | same, 3959, 3996 | startCamera | Fusion init | no |
# | same, 5209 | threadFunc_zedGrab | positional tracking cannot start | no, tracking is off |
# | same, 5406 | threadFunc_zedGrab, grab thread | critical grab error | yes |
# | same, 6381 | publishCameraTFs, grab thread (called from publishTFs at 5583) | unknown model | no, our three stereo models are in the switch |
# | zed_camera/src/zed_camera_component_objdet.cpp 77, 84, 190 | object detection parameters | | no |
# | zed_camera_one/src/zed_camera_one_component_main.cpp 90 | constructor | SDK version check | no, compile-time constant, SDK 5.5.0 passes |
# | same, 482 | getStreamParams | stream input | no |
# | same, 510, 531, 552, 576 | getCameraModelParams | `else if (!IS_JETSON)` branches | no, non-Jetson host |
# | same, 956 | initNode, 50 ms one-shot timer | startCamera() returned false | yes |
# | same, 2508 | performCameraGrab, grab thread | critical grab error | yes |
#
# Counts: 33, 3 and 8 calls before; 31, 3 and 6 after. The 16 debug-flag sites
# are reachable only through `debug.debug_camera_controls`, default false,
# which the driver never sets.

diff --git a/zed_components/src/zed_camera/src/zed_camera_component_main.cpp b/zed_components/src/zed_camera/src/zed_camera_component_main.cpp
index 43a69f5..441b0e1 100644
