@@ -208,15 +208,17 @@ void ZedCamera::initNode()
   mDiagUpdater.setHardwareID(hw_id);
   // <---- Diagnostic initialization
 
-  // Services initialization
-  initServices();
-
   // ----> Start camera
   if (!startCamera()) {
-    exit(EXIT_FAILURE);
+    RCLCPP_ERROR(get_logger(), "Camera start failed. Component stopped.");
+    deInitNode();
+    return;
   }
   // <---- Start camera
 
+  // Services initialization
+  initServices();
+
   // Callback when the node is destroyed
   // This is used to stop the camera when the node is destroyed
   // and to stop the timers
@@ -224,7 +226,12 @@ void ZedCamera::initNode()
   // Close camera callback before shutdown
   using rclcpp::contexts::get_global_default_context;
   get_global_default_context()->add_pre_shutdown_callback(
-    [this]() {
+    [this, weak_node = weak_from_this()]() {
+      // The context keeps this callback after the node is destroyed.
+      const auto node = weak_node.lock();
+      if (!node) {
+        return;
+      }
       DEBUG_COMM("ZED Component is shutting down");
       deInitNode();
       DEBUG_COMM("ZED Component is shutting down - done");
@@ -5402,8 +5409,8 @@ void ZedCamera::threadFunc_zedGrab()
             get_logger(),
             "Critical camera error: " << sl::toString(mGrabStatus).c_str()
                                       << ". NODE KILLED.");
-          mZed.reset();
-          exit(EXIT_FAILURE);
+          mThreadStop = true;
+          break;
         }
       }
       // <---- Grab errors?
