# Build up the service with these stages:
#   - base (ros:jazzy + settings) ->
#   - underlay (dependencies) ->
#   - overlay (user code) ->
#   - result (base + copied install folder of underlay and overlay)

# base stage: ros:jazzy + configs
# base stage: NVIDIA CUDA base + ROS Jazzy + configs
FROM nvidia/cuda:12.5.1-base-ubuntu24.04 AS base

ARG ZIVID_VERSION=2.17.0+5fc9f05e-1

# Install ROS Jazzy
RUN apt-get update && apt-get install -y \
    curl \
    gnupg2 \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null
RUN apt-get clean && apt-get update && apt-get install -y --fix-missing \
    ros-jazzy-ros-base \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ros/underlay

ENV ROS_DISTRO=jazzy
ENV ROS_HOME=/tmp
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp

# underlay stage: base + dependencies built
FROM base AS underlay

ARG ZIVID_VERSION
ADD src/zivid-ros /opt/ros/underlay/src/zivid-ros
ADD src/flowstate-ros-camera-drivers /opt/ros/underlay/src/flowstate-ros-camera-drivers
ADD src/sdk-ros /opt/ros/underlay/src/sdk-ros

# Install build dependencies. Use ocl-icd-libopencl1 for NVIDIA compatibility.
RUN . /opt/ros/jazzy/setup.sh && \
    apt-get update && \
    apt-get install -y \
    ocl-icd-libopencl1 gcc g++ clinfo \
    python3-rosdep \
    python3-colcon-common-extensions \
    ros-jazzy-ament-cmake-vendor-package \
    valgrind ninja-build\
    && rosdep init && \
    rosdep update && \
    rosdep install --from-paths /opt/ros/underlay/src --ignore-src --rosdistro jazzy -y --skip-keys "snapshot_interfaces OrbbecSDK" && \
    colcon build \
        --continue-on-error \
        --merge-install \
        --packages-up-to intrinsic_sdk \
        --parallel-workers 2 \
        --cmake-args -GNinja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
        && \
    echo "Searching for and copying vendored libprotobuf..." && \
    find /opt/ros/underlay/build -name "libprotobuf.so.29.0.0" -exec cp {} /opt/ros/underlay/install/lib/ \; && \
    echo "Searching for and copying vendored absl libraries..." && \
    find /opt/ros/underlay/build/abseil_cpp_vendor -name "libabsl*.so*" -exec cp -d {} /opt/ros/underlay/install/lib/ \; && \
    rm -rf /opt/ros/underlay/build /opt/ros/underlay/log /var/lib/apt/lists/* /root/.ros/rosdep

# Configure OpenCL for NVIDIA GPU
RUN mkdir -p /etc/OpenCL/vendors && \
    echo "libnvidia-opencl.so.1" > /etc/OpenCL/vendors/nvidia.icd

# Set environment for NVIDIA GPU access during build
ENV NVIDIA_VISIBLE_DEVICES all
ENV NVIDIA_DRIVER_CAPABILITIES compute,utility


RUN apt-get update && apt-get install -y wget && \
    wget \
    https://downloads.zivid.com/sdk/releases/${ZIVID_VERSION}/u24/amd64/zivid_${ZIVID_VERSION}_amd64.deb \
    https://downloads.zivid.com/sdk/releases/${ZIVID_VERSION}/u24/amd64/zivid-studio_${ZIVID_VERSION}_amd64.deb \
    https://downloads.zivid.com/sdk/releases/${ZIVID_VERSION}/u24/amd64/zivid-tools_${ZIVID_VERSION}_amd64.deb \
    https://downloads.zivid.com/sdk/releases/${ZIVID_VERSION}/u24/amd64/zivid-genicam_${ZIVID_VERSION}_amd64.deb && \
    apt-get install -y ./*.deb && \
    rm ./*.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
# Set LD_LIBRARY_PATH to include NVIDIA libraries for OpenCL discovery during build
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}

# install rmw_zenoh
RUN cd /opt/ros/underlay/src/ \
    && git clone https://github.com/codebot/rmw_zenoh -b morganquigley/jazzy_with_old_attachment_metadata_format && cd rmw_zenoh && git checkout 05cdda05a7c5e7c2871e6d85bfc9411546a529c4 && cd ../.. \
    && . /opt/ros/jazzy/setup.sh \
    && apt-get update \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src --rosdistro jazzy -yr \
    && colcon build \
        --merge-install \
        --packages-up-to=rmw_zenoh_cpp \
        --parallel-workers 2 \
        --cmake-args -GNinja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf /opt/ros/underlay/build /opt/ros/underlay/log /var/lib/apt/lists/*

# overlay stage: underlay + service code built
FROM underlay AS overlay

ARG SERVICE_PACKAGE
ARG DEPENDENCIES

RUN apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get update \
    && apt install -y --fix-missing python3-protobuf libopencv-dev nlohmann-json3-dev ${DEPENDENCIES} \
    && rm -rf /var/lib/apt/lists/*

ADD src /opt/ros/overlay/src

RUN . /opt/ros/jazzy/setup.sh \
    && . /opt/ros/underlay/install/setup.sh \
    && cd /opt/ros/overlay \
    && colcon build \
      --merge-install \
      --packages-above-and-dependencies=${SERVICE_PACKAGE} \
      --parallel-workers 2 \
      --cmake-args -GNinja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf /opt/ros/overlay/build /opt/ros/overlay/log /opt/ros/overlay/src /opt/ros/underlay/src \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /root/.cache

RUN ls -l /opt/ros/overlay/install/lib/${SERVICE_PACKAGE}
RUN ls -R /opt/ros/overlay/install

# result stage: base + copied install folders from the overlay + service setup
FROM base

ARG SERVICE_PACKAGE
ARG SERVICE_NAME
ARG DEPENDENCIES
ARG ZIVID_VERSION

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY --from=ros:jazzy /ros_entrypoint.sh /ros_entrypoint.sh
RUN apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get update \
    && apt-get install -y --fix-missing \
    ros-jazzy-image-transport \
    ros-jazzy-image-transport-plugins \
    ocl-icd-libopencl1 \
    ros-jazzy-std-srvs \
    wget && \
    # Download and install Zivid SDK runtime dependencies
    wget -O zivid.deb https://downloads.zivid.com/sdk/releases/${ZIVID_VERSION}/u24/amd64/zivid_${ZIVID_VERSION}_amd64.deb && \
    wget -O zivid-tools.deb https://downloads.zivid.com/sdk/releases/${ZIVID_VERSION}/u24/amd64/zivid-tools_${ZIVID_VERSION}_amd64.deb && \
    # The 'apt-get update' here is critical for installing dependencies of the .deb files
    apt-get update && apt-get install -y ./*.deb && \
    rm ./*.deb && rm -rf /var/lib/apt/lists/*

COPY --from=overlay /opt/ros/underlay/install /opt/ros/underlay/install
COPY --from=overlay /opt/ros/overlay/install /opt/ros/overlay/install
COPY --from=overlay /etc/OpenCL/vendors /etc/OpenCL/vendors

# Configure the dynamic linker to find libraries in /usr/local/lib, which is
# not always in the default search path. ROS libraries are found via the
# entrypoint script which sets LD_LIBRARY_PATH.
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf && ldconfig
RUN cp \
        /opt/ros/overlay/install/share/${SERVICE_PACKAGE}/${SERVICE_NAME}/service_manifest.binarypb \
        /service_manifest.binarypb \
    && sed --in-place \
        --expression '$isource "/opt/ros/overlay/install/setup.bash"' \
        /ros_entrypoint.sh

# Set LD_LIBRARY_PATH to include NVIDIA libraries for OpenCL discovery
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}
ENTRYPOINT ["/ros_entrypoint.sh"]


ENV SERVICE_PACKAGE=${SERVICE_PACKAGE}
ENV SERVICE_NAME=${SERVICE_NAME}
ENV RUST_LOG=info

ENV ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/localhost:17447"]'

RUN ls -l /opt/ros/overlay/install/lib/${SERVICE_PACKAGE}

CMD exec /opt/ros/overlay/install/lib/${SERVICE_PACKAGE}/zivid_driver_main
